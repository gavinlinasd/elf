{
  "manifest_version": 3,
  "name": "YouTube Shorts Blocker",
  "description": "Removes YouTube Shorts surfaces and redirects Shorts pages so you only see long-form videos.",
  "version": "1.0.0",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
